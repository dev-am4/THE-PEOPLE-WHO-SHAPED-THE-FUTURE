{
  "name": "the-people-who-shaped-the-future",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare:offline": "node scripts/cache-offline-portraits.mjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run prepare:offline && npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "latest",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "qrcode.react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "th.go.nakhonsawan.tpwsf",
    "productName": "THE PEOPLE WHO SHAPED THE FUTURE",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "THE-PEOPLE-WHO-SHAPED-THE-FUTURE-${version}-Windows-${arch}.${ext}"
    }
  }
}
